{
  "name": "comitadus-eventos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p backend/tsconfig.json",
    "start": "node backend/dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test": "tsx scripts/prepare-test.ts && vitest run",
    "test:integration": "tsx scripts/prepare-test.ts && vitest run backend/tests/integration.test.ts",
    "check": "tsc --noEmit",
    "test:restart": "tsx scripts/verify-restart.ts"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
